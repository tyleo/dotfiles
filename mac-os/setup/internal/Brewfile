# Homebrew formulae & casks. Installed by homebrew.sh.
# VS Code extensions, cargo crates, direct-download apps, and Mac App Store apps
# live in their own step scripts, not here.
# Regenerate these lines with: brew bundle dump --force --file=mac-os/setup/internal/Brewfile

# Secure runtime for JavaScript and TypeScript
brew "deno"
# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# Command-line fuzzy finder written in Go
brew "fzf"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Quickly rewrite git repository history
brew "git-filter-repo"
# Git extension for versioning large files
brew "git-lfs"
# Graph visualization software from AT&T and Bell Labs
brew "graphviz"
# Website copier/offline browser
brew "httrack"
# Tools and libraries to manipulate images in select formats
brew "imagemagick"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Create, run, and share large language models (LLMs)
brew "ollama"
# Draw UML diagrams
brew "plantuml"
# PDF rendering library (based on the xpdf-3.0 code base)
brew "poppler"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Cross-shell prompt for astronauts
brew "starship"
# Terminal image and video viewer
brew "timg"
# Web Assembly Binary Toolkit
brew "wabt"
# Image format providing lossless and lossy compression for web images
brew "webp"
# Utilities to create and convert Web Open Font File (WOFF) files
brew "woff2"
# yt-dlp is NOT here on purpose: the brew formula lags upstream by months and its
# pip-wheel install blocks "yt-dlp -U". cli.sh installs the self-updating standalone
# binary instead. ffmpeg above stays - yt-dlp needs it to merge audio/video streams.

# System-wide ad and tracker blocker (privileged pkg installer; self-updates)
cask "adguard"
# Multi-track audio editor and recorder; no self-update, brew handles upgrades
cask "audacity"
# 3D creation suite; no self-update, brew handles upgrades
cask "blender"
# Cross-platform Git credential storage for multiple hosting providers
cask "git-credential-manager"
# Keyboard customizer (pkg installs a DriverKit extension; also adds EventViewer)
cask "karabiner-elements"
# Free and open-source painting and sketching program
cask "krita"
# Keyboard layout for programmers
cask "programmer-dvorak"
# Ubiquiti Wi-Fi network analyzer and troubleshooter (pkg + privileged helper)
cask "wifiman"

cask "font-fira-code"
cask "font-fira-code-nerd-font"
cask "font-monaspace"
