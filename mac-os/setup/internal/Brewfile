# Homebrew taps, formulae & casks. Installed by homebrew.sh.

# Non-official taps; homebrew.sh trusts each before this file installs
# Tap serving moshi-hook
tap "rjyo/moshi"

# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Secure runtime for JavaScript and TypeScript
brew "deno"
# Select default apps for documents and URL schemes on macOS
brew "duti"
# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# Command-line fuzzy finder written in Go
brew "fzf"
# Replace zsh completion selection menu with fzf
brew "fzf-tab"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# Syntax-highlighting pager for git and diff output
brew "git-delta"
# Quickly rewrite git repository history
brew "git-filter-repo"
# Git extension for versioning large files
brew "git-lfs"
# Render markdown on the CLI
brew "glow"
# Graph visualization software from AT&T and Bell Labs
brew "graphviz"
# Website copier/offline browser
brew "httrack"
# Tools and libraries to manipulate images in select formats
brew "imagemagick"
# Lightweight and flexible command-line JSON processor
brew "jq"
# Remote terminal application
brew "mosh"
# Portable daemon + CLI that bridges AI coding agents to the Moshi mobile app
brew "moshi-hook", start_service: true
# Create, run, and share large language models (LLMs)
brew "ollama"
# Draw UML diagrams
brew "plantuml"
# PDF rendering library (based on the xpdf-3.0 code base)
brew "poppler"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Cross-shell prompt for astronauts
brew "starship"
# Terminal image and video viewer
brew "timg"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"
# Web Assembly Binary Toolkit
brew "wabt"
# Image format providing lossless and lossy compression for web images
brew "webp"
# Utilities to create and convert Web Open Font File (WOFF) files
brew "woff2"
# Fish-like fast/unobtrusive autosuggestions for zsh
brew "zsh-autosuggestions"
# Fish shell like syntax highlighting for zsh
brew "zsh-syntax-highlighting"

# System-wide ad and tracker blocker (privileged pkg installer; self-updates)
cask "adguard"
# Google's Android developer CLI; no self-update, brew handles upgrades
cask "android-cli"
# Diff and merge tool; update check only notifies, brew handles upgrades
cask "araxis-merge"
# Multi-track audio editor and recorder; updater only downloads the installer,
# brew handles upgrades
cask "audacity"
# 3D creation suite; no self-update, brew handles upgrades
cask "blender"
# Cross-platform Git credential storage for multiple hosting providers; no
# self-update, brew handles upgrades
cask "git-credential-manager"
# Keyboard customizer (pkg installs a DriverKit extension;
# also adds EventViewer)
cask "karabiner-elements"
# Free and open-source painting and sketching program; update check only
# notifies, brew handles upgrades
cask "krita"
# Simple raster image editor; no self-update, brew handles upgrades
cask "pinta"
# Keyboard layout for programmers; no self-update, brew handles upgrades
cask "programmer-dvorak"
# Game store; the cask ships Valve's self-updating universal bootstrapper
cask "steam"
# Adoptium's JDK; unversioned because Gradle fetches the JDK each build pins
cask "temurin"

cask "font-fira-code"
cask "font-fira-code-nerd-font"
cask "font-monaspace"
